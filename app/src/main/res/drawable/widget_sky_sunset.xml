<?xml version="1.0" encoding="utf-8"?>
<!-- Widget sky: sunset -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:type="linear"
        android:startColor="#E62A1745"
        android:centerColor="#E68C2F4A"
        android:endColor="#E6E0703A" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
